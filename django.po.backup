#: src/templates/dashboard.html:32
msgid "Your pets' profiles are here."
msgstr "Patili dostlarının profilleri burada."

#: src/templates/dashboard.html:35
msgid "Add a new pet"
msgstr "Yeni hayvan ekle"

#: src/templates/dashboard.html:36
msgid "Enter your pet's details below."
msgstr "Patili dostunun bilgilerini aşağıya gir."

#: src/templates/dashboard.html:43
msgid "Save pet"
msgstr "Hayvanı kaydet"

#: src/templates/dashboard.html:52
msgid "Back to home"
msgstr "Ana sayfaya dön"

#: src/templates/dashboard.html:92
msgid "You haven't added a pet profile yet."
msgstr "Henüz bir hayvan profili eklemedin."

#: src/templates/home.html:25
msgid "FOR OUR FURRY FRIENDS"
msgstr "PATİLİ DOSTLARIMIZ İÇİN"

#: src/templates/home.html:28
msgid ""
"\n"
"                Their world,<br>made brighter by your love.\n"
"            "
msgstr ""
"\n"
"                Onların dünyası,<br>senin sevginle güzel.\n"
"            "

#: src/templates/home.html:34
msgid ""
"Keep your pets' profiles in one place. Organize their details and give them "
"better care."
msgstr ""
"Hayvan profillerini tek yerde tut. Bilgilerini düzenle ve onlara daha iyi "
"bak."

#: src/templates/home.html:39
msgid "View my pets"
msgstr "Hayvanlarımı gör"

#: src/templates/home.html:43
msgid "Create your pet family"
msgstr "Patili aileni oluştur"

#: src/templates/home.html:52
msgid "THE PAWSOME MEMBERS OF YOUR FAMILY"
msgstr "AİLENİN PATİLİ ÜYELERİ"

#: src/templates/home.html:54
msgid "My pets"
msgstr "Hayvanlarım"

